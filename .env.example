# Leave these blank to run against the local Firebase emulator (no account needed).
# To go online: create a free Firebase project, enable Realtime Database,
# then copy the web app config here and set NEXT_PUBLIC_FIREBASE_USE_EMULATOR=0.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=1
