{
  "name": "t-60secondsweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n next,db -c cyan,magenta \"npm:dev:next\" \"npm:dev:db\"",
    "dev:next": "next dev",
    "dev:db": "firebase emulators:start --only database --project demo-t60",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-lobby.ts",
    "test:lobby": "firebase emulators:exec --only database --project demo-t60 \"npm run smoke\"",
    "deploy:rules": "firebase deploy --only database"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "firebase-tools": "^15.36.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
